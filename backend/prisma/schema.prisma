
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String        @id @default(uuid())
  name              String
  email             String        @unique
  password           String
  role              String        @default("STUDENT")
  xp                Int           @default(0)
  // ---- Premium + referral ----
  premiumUntil       DateTime?
  referralCode       String?       @unique
  referredById       String?
  referralRewarded   Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  submissions        Submission[]
  createdChallenges  Challenge[]
  payments           Payment[]
  weeklyAwards       WeeklyAward[]
}

model Challenge {
  id          String       @id @default(uuid())
  order       Int          @default(0)
  title       String
  topic       String
  lesson      String?
  description String
  category    String
  difficulty  String
  solution    String?
  xpReward    Int          @default(100)
  deadline    DateTime
  createdAt   DateTime     @default(now())
  // ---- Premium content ----
  isPremium   Boolean      @default(false)
  isBonus     Boolean      @default(false)
  company     String?
  creatorId  String?
  creator    User?        @relation(fields: [creatorId], references: [id])
  submissions Submission[]
}

model Submission {
  id          String   @id @default(uuid())
  content     String
  status      String   @default("PENDING")
  score       Int?
  feedback    String?
  createdAt   DateTime @default(now())
  userId      String
  challengeId String
  user        User      @relation(fields: [userId], references: [id])
  challenge   Challenge @relation(fields: [challengeId], references: [id])
}

model Payment {
  id        String   @id @default(uuid())
  plan      String
  amountInr Int
  provider  String   @default("TEST")
  status    String   @default("PAID")
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

// Weekly leaderboard prize (free Premium days).
// The unique key makes sure a week is paid out only once.
model WeeklyAward {
  id        String   @id @default(uuid())
  weekKey   String
  rank      Int
  days      Int
  xp        Int
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@unique([weekKey, userId])
}
